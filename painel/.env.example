# Painel Central — copie para painel/.env e preencha.
# Subir: pm2 start painel/server.js --name painel-central && pm2 save

# Porta do painel
PORT=3100

# Token de acesso ao painel (invente um forte — pedido no primeiro acesso)
PAINEL_TOKEN=defina-um-token-forte

# MySQL (mesmo servidor das instâncias; o database painel_central é criado sozinho)
DB_HOST=localhost
DB_PORT=3306
DB_USER=mitouser
DB_PASSWORD=naoteconto
# PAINEL_DB_NAME=painel_central
