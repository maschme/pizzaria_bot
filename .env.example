# Copie para .env e preencha. Opção 1: uma instância = uma empresa = um banco.
# Cada instância usa seu próprio .env (PORT, DB_NAME, PM2_APP_NAME diferentes).

# Porta do servidor HTTP (Ex.: 3007, 3008 para múltiplas instâncias)
PORT=3007

# Nome no PM2 (ex.: pizzaria-loja1, empresa-x). Usado pelo setup.sh / setup.ps1
PM2_APP_NAME=pizzaria-bot

# Banco de dados (um database por empresa, ex.: pizzaria_loja1, pizzaria_loja2)
DB_HOST=vms.cutplay.com.br
DB_PORT=3306
DB_USER=mitouser
DB_PASSWORD=naoteconto
DB_NAME=pizzaria

# Token de administrador do dashboard e APIs (/api/*, /whatsapp, /config, /campanha, /send-message).
# Invente uma chave forte. Sem esta variável o sistema roda ABERTO (apenas loga aviso).
# Exceção pública: POST /api/fluxos/:id/webhook (gatilho de automações), /webhook/movimento
# e /webhook/multipedidos/<secret> (autenticado pelo próprio segredo).
ADMIN_TOKEN=defina-um-token-forte-aqui

# Chaves de IA (usadas pelo seed do setup e pelo fallback legado ias.js).
# Os provedores também podem ser configurados pelo dashboard (ia-config.html).
QWEN_API_KEY=
OPENROUTER_API_KEY=

# Motor de WhatsApp: wwebjs (default, whatsapp-web.js/Puppeteer) ou evolution (Evolution API)
# Trocar o motor NÃO migra a sessão: cada motor pareia o número do zero (novo QR).
WA_ENGINE=wwebjs

# Config do motor evolution (obrigatória quando WA_ENGINE=evolution)
# EVOLUTION_URL=http://localhost:8033
# EVOLUTION_APIKEY=
# EVOLUTION_INSTANCE=pizzaria
# Segredo do endpoint que recebe os webhooks (/webhook/evolution/<secret>) — invente um forte
# EVOLUTION_WEBHOOK_SECRET=
# URL deste bot alcançável pela Evolution (container Docker NÃO enxerga localhost do host)
# EVOLUTION_PUBLIC_URL=http://vms.cutplay.com.br:3087

# Integração Multipedidos (docs/17-integracao-multipedidos.md e docs/18-cupons-multipedidos.md)
# Os segredos ficam AQUI; ligar/desligar webhook e API é pela tela Integrações do dashboard.
# Segredo do endpoint de captura de webhooks (/webhook/multipedidos/<secret>) — invente um forte.
# Sem esta variável (ou com o webhook desligado na tela) o endpoint responde 404.
# MULTIPEDIDOS_WEBHOOK_SECRET=
# "Token de autenticação (access_token)" cadastrado no painel da Multipedidos junto com a URL do webhook
# (chega no header access_token). Com esta variável definida, só é PROCESSADO (uso de cupom, metas) o evento
# cujo header bate; evento com token diferente continua capturado, e a tela Integrações avisa.
# MULTIPEDIDOS_WEBHOOK_TOKEN=
# Token de Integração da API da Multipedidos (gerado no painel deles). Equivale a credencial de
# administrador da loja — nunca versionar nem colar em chat/log.
# MULTIPEDIDOS_TOKEN=
# URL pública desta instância, usada para montar a URL do webhook exibida na tela Integrações
# (opcional; default: o host pelo qual o dashboard foi acessado).
# PUBLIC_URL=http://meu-host:3087

# Sessão WhatsApp (uma por instância/empresa)
# WA_SESSION_ID define a pasta .wwebjs_auth/session-<id>. Trocar o id exige escanear QR de novo.
# Se omitido, usa o id histórico "bot-ia-pizzaria3" (compatível com instalações existentes).
WA_SESSION_ID=bot-ia-pizzaria3
# Diretório base das sessões (opcional; default: ./.wwebjs_auth na pasta do projeto)
# WA_AUTH_DIR=/dados/sessoes-whats/empresa-x
# Caminho do Chrome/Chromium (opcional; default: o baixado pelo Puppeteer)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Backup automatizado (scripts/backup.js — agendar: pm2 start scripts/backup.js --name backup-<slug> --cron "0 4 * * *" --no-autorestart)
# BACKUP_DIR=/home/chia/backups        (default: ../backups relativo ao projeto)
# BACKUP_RETENCAO_DIAS=14

# Limpeza diária dos cupons únicos da Multipedidos (scripts/multipedidos-cupons-limpeza.js — docs/18 §6):
#   pm2 start scripts/multipedidos-cupons-limpeza.js --name cupons-limpeza-<slug> --cron "30 4 * * *" --no-autorestart

# Monitor de saúde (scripts/monitor-health.js — rodar como processo PM2 separado)
# HEALTH_URL=http://localhost:3007/health
# MONITOR_INTERVALO_S=60
# MONITOR_REALERTA_MIN=30
# Canal de alerta genérico (POST JSON):
# ALERTA_WEBHOOK_URL=
# Canal de alerta via Evolution API (manda WhatsApp para o operador):
# ALERTA_EVOLUTION_URL=http://localhost:8033
# ALERTA_EVOLUTION_APIKEY=
# ALERTA_EVOLUTION_INSTANCE=
# ALERTA_NUMERO=5547999999999
